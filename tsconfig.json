{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src"],
  "exclude": [
    "src/components/App.tsx",
    "src/components/analytics.ts",
    "src/components/appState.tsx",
    "src/components/cloudSync.ts",
    "src/components/core.ts",
    "src/components/hijriDate.ts"
  ]
}
